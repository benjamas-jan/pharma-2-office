# Resend API key — required for the contact form to send email notifications.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default Resend "from" address.
# Defaults to "Wellness Plus <onboarding@resend.dev>" (Resend sandbox sender).
# To send from your own domain, verify the domain in Resend then set e.g.
# LEAD_FROM_EMAIL="Wellness Plus <noreply@your-domain.com>"
# LEAD_FROM_EMAIL=
